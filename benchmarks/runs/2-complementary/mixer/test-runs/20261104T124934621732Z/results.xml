<?xml version="1.0" encoding="utf-8"?>
<testsuite name="unittest" tests="18">
  <testcase classname="tests.test_v1_core.AccountsTests" name="test_account_password_is_salted_pbkdf2" time="0.017">
    <properties>
      <property name="features" value="M01"/>
      <property name="expect" value="account passwords are stored as pbkdf2_sha256 with a per-user salt, never in plain text"/>
      <property name="level" value="database"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.AccountsTests" name="test_register_login_logout" time="0.019">
    <properties>
      <property name="features" value="M01, M02"/>
      <property name="expect" value="register sets an http-only session cookie; logout ends it; login with the right password restores it"/>
      <property name="level" value="auth"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.AccountsTests" name="test_session_expires" time="0.016">
    <properties>
      <property name="features" value="M02"/>
      <property name="expect" value="a session older than 7 days answers 401"/>
      <property name="level" value="auth"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.AccountsTests" name="test_wrong_password_and_duplicate_username" time="0.015">
    <properties>
      <property name="features" value="M01"/>
      <property name="expect" value="wrong password is 401 bad_credentials; a taken username is 409; short passwords are 400"/>
      <property name="level" value="auth"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.FallbackPreviewTests" name="test_other_types_have_no_preview" time="0.031">
    <properties>
      <property name="features" value="M06"/>
      <property name="expect" value=".pdf, .zip and extensionless files preview as kind none with the reason"/>
      <property name="level" value="feature"/>
      <property name="acceptance" value="AC08"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.ListTests" name="test_each_user_sees_only_their_files" time="0.029">
    <properties>
      <property name="features" value="M02"/>
      <property name="expect" value="two users each list only their own files, newest first"/>
      <property name="level" value="auth"/>
      <property name="acceptance" value="AC04"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.ListTests" name="test_empty_list" time="0.021">
    <properties>
      <property name="features" value="M02"/>
      <property name="expect" value="a new user gets an empty list"/>
      <property name="level" value="feature"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.PlatformTests" name="test_invalid_json_is_400" time="0.014">
    <properties>
      <property name="features" value="M07"/>
      <property name="expect" value="a malformed JSON body answers 400 invalid_json"/>
      <property name="level" value="api"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.PlatformTests" name="test_pages_and_unknown_routes" time="0.014">
    <properties>
      <property name="features" value="M02, M09"/>
      <property name="expect" value="/ and /s/&lt;token&gt; serve HTML; unknown routes are 404 and wrong methods 405, both in the JSON error shape"/>
      <property name="level" value="navigation"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.PlatformTests" name="test_schema_created_from_empty_with_foreign_keys" time="0.014">
    <properties>
      <property name="features" value="M01"/>
      <property name="expect" value="every table exists after start and foreign keys cascade from files"/>
      <property name="level" value="database"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.TextPreviewTests" name="test_preview_of_someone_elses_file_is_404" time="0.021">
    <properties>
      <property name="features" value="M04"/>
      <property name="expect" value="previewing another user's file answers 404 not_found"/>
      <property name="level" value="auth"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.TextPreviewTests" name="test_text_preview_first_20_lines" time="0.022">
    <properties>
      <property name="features" value="M04"/>
      <property name="expect" value=".txt, .md and .csv (any case) preview as kind text with at most 20 lines"/>
      <property name="level" value="feature"/>
      <property name="acceptance" value="AC06"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.TextPreviewTests" name="test_text_preview_replaces_invalid_utf8" time="0.014">
    <properties>
      <property name="features" value="M04"/>
      <property name="expect" value="undecodable bytes become replacement characters instead of an error"/>
      <property name="level" value="feature"/>
      <property name="acceptance" value="AC06"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.UploadTests" name="test_file_endpoints_need_sign_in" time="0.012">
    <properties>
      <property name="features" value="M01, M02, M03, M04, M07"/>
      <property name="expect" value="every owner endpoint answers 401 with the JSON error shape when nobody is signed in"/>
      <property name="level" value="auth"/>
      <property name="acceptance" value="AC03"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.UploadTests" name="test_upload_limit_is_10_mb" time="0.086">
    <properties>
      <property name="features" value="M01"/>
      <property name="expect" value="exactly 10485760 bytes is accepted; 10485761 is 413 file_too_large and nothing is stored"/>
      <property name="level" value="feature"/>
      <property name="acceptance" value="AC02"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.UploadTests" name="test_upload_rejects_oversize_content_length_before_reading" time="0.018">
    <properties>
      <property name="features" value="M01"/>
      <property name="expect" value="a Content-Length over the limit is refused with 413 without reading the body"/>
      <property name="level" value="api"/>
      <property name="acceptance" value="AC02"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.UploadTests" name="test_upload_returns_file" time="0.023">
    <properties>
      <property name="features" value="M01"/>
      <property name="expect" value="201 with id, name, size and a guessed content type"/>
      <property name="level" value="api"/>
      <property name="acceptance" value="AC01"/>
    </properties>
  </testcase>
  <testcase classname="tests.test_v1_core.UploadTests" name="test_upload_validation" time="0.018">
    <properties>
      <property name="features" value="M01"/>
      <property name="expect" value="missing or unsafe names are 400 invalid_name; a missing Content-Length is 411"/>
      <property name="level" value="form"/>
    </properties>
  </testcase>
</testsuite>
