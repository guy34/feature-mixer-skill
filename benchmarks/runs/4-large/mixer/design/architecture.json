      "id": "V4",
      "name": "Stale-deal reminders",
      "features": [
        "M06"
      ],
      "status": "pending"
    }
  ],
  "decisions": [
    {
      "id": "D01",
      "decision": "Python 3.12 + Django 5.2 LTS backend",
      "reason": "both sources are Python; brings auth, sessions, ORM, migrations",
      "approved": true
    },
    {
      "id": "D02",
      "decision": "Server-rendered Django templates; drop React and lodash",
      "reason": "no UI source exists in either app; the packages are declared but never imported",
      "approved": true
    },
    {
      "id": "D03",
      "decision": "PostgreSQL in production, SQLite in development and tests",
      "reason": "transactions and uuid keys; dependency-free tests",
      "approved": true
    },
    {
      "id": "D04",
      "decision": "Reminders as a daily management command run by cron",
      "reason": "one low-volume job; no queue needed",
      "approved": true
    },
    {
      "id": "D05",
      "decision": "Django email backend over SMTP; locmem backend in tests",
      "reason": "keeps the mailer injectable like B's",
      "approved": true
    },
    {
      "id": "D06",
      "decision": "Modular monolith with six modules (accounts, contacts, pipeline, contact-merge, reporting, reminders)",
      "reason": "see style; contact-merge is its own module so contacts and pipeline have no dependency cycle",
      "approved": true
    },
    {
      "id": "D07",
      "decision": "uuid primary keys everywhere with legacy_source and legacy_id on imported rows",
      "reason": "compatibility decision database:primary-key:deal",
      "approved": true
    },
    {
      "id": "D08",
      "decision": "Configurable Stage table with an outcome column, seeded with A's stages plus closed (unspecified)",
      "reason": "compatibility decisions application:rule:deal-stages and database:field-type:deal.stage",
      "approved": true
    },
    {
      "id": "D09",
      "decision": "User entity and required Deal.owner_id; roles admin and member; one can(user, action, record) check",
      "reason": "compatibility decision application:workflow:deal-owner; neither source has auth",
      "approved": true
    },
    {
      "id": "D10",
      "decision": "REST JSON API under /api/v1 with error shape {error: {code, message}}, cursor pagination (?cursor=, limit max 100), session auth on every endpoint except login",
      "reason": "one API style, one version scheme, one error shape",
      "approved": true
    }
  ]
}