{
  "style": {
    "selected": "modular-monolith",
    "drivers": [
      "one small sales team, one release cadence",
      "strong consistency: contact merge must move deals atomically",
      "low volume; no part needs independent scaling",
      "the only asynchronous work is one daily reminder job"
    ],
    "alternatives": [
      {
        "style": "microservices",
        "fit": "poor",
        "reason": "contacts, deals and merge share one transaction; splitting them adds network calls and distributed data with no scaling or team need"
      },
      {
        "style": "event-driven",
        "fit": "partial",
        "reason": "reminders are asynchronous, but one scheduled job at low volume does not justify message infrastructure"
      },
      {
        "style": "hybrid",
        "fit": "partial",
        "reason": "a monolith plus an event pipeline for reminders would add a second set of rules for a single daily job"
      },
      {
        "style": "service-oriented",
        "fit": "poor",
        "reason": "there are no existing systems that must stay separate; both sources are small and are rebuilt into one"
      }
    ],
    "reason": "The simplest design that meets every driver: one deployable, one database, reminders as a scheduled command inside the same codebase"
  },
  "stack": {
    "frontend": "Server-rendered Django templates with a small amount of vanilla JS for the deal board",
    "backend": "Python 3.12, Django 5.2 LTS",
    "database": "PostgreSQL 16 (SQLite for local development and tests)",
    "jobs": "Django management command send_stale_reminders, run daily by the host's scheduler (cron)",
    "email": "Django email backend over SMTP (provider chosen by the user)",
    "hosting": "Any managed Python host with PostgreSQL and a cron feature; not chosen (no constraint given, no deployment in this run)",
    "reasons": {
      "backend": "D01: both sources are Python and M01 adapts A's Python logic; Django is boring, well documented and brings auth, sessions, ORM and migrations that neither source has",
      "frontend": "D02: neither source has a usable UI (A declares React but ships no UI source; B has none); server-rendered pages are the least code for a small internal CRM; react and lodash are dropped (declared but never imported)",
      "database": "D03: PostgreSQL for transactions (contact merge) and uuid keys; SQLite keeps local tests dependency-free",
      "jobs": "D04: one daily job does not need a queue; a management command plus cron is the simplest scheduler",
      "email": "D05: Django's email backend keeps the mailer injectable like B's and testable with the locmem backend"
    }
  },
  "modules": [
    {
      "name": "accounts",
      "responsibility": "Users, sign-in, sessions, roles and the single permission check can(user, action, record)",
      "features": [],
      "depends_on": [],
      "owns_entities": [
        "User"
      ]
    },
    {
      "name": "contacts",
      "responsibility": "Create, edit, list and search contacts",
      "features": [
        "M01"
      ],
      "depends_on": [
        "accounts"
      ],
      "owns_entities": [
        "Contact"
      ]
    },
    {
      "name": "pipeline",
      "responsibility": "Deals, configurable stages and stage moves (records moved_at)",
      "features": [
        "M03",
        "M04"
      ],
      "depends_on": [
        "accounts",
        "contacts"
      ],
      "owns_entities": [
        "Deal",
        "Stage"
      ]
    },
    {
      "name": "contact-merge",
      "responsibility": "Transactional merge of a duplicate contact into another, with an audit entry",
      "features": [
        "M02"
      ],
      "depends_on": [
        "accounts",
        "contacts",
        "pipeline"
      ],
      "owns_entities": [
        "ContactMerge"
      ]
    },
    {
      "name": "reporting",
      "responsibility": "CSV export of contacts and deals",
      "features": [
        "M05"
      ],
      "depends_on": [
        "accounts",
        "contacts",
        "pipeline"
      ],
      "owns_entities": []
    },
    {
      "name": "reminders",
      "responsibility": "Daily stale-deal reminder job and its send log",
      "features": [
        "M06"
      ],
      "depends_on": [
        "accounts",
        "pipeline"
      ],
      "owns_entities": [
        "ReminderLog"
      ]
    }
  ],
  "entities": [
    {
      "name": "User",
      "merged_from": [
        "new"
      ],
      "primary_key": "uuid",
      "notes": "New: neither source has users. Created from B's distinct Deal.owner_email values at migration.",
      "fields": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "email",
          "type": "text",
          "from": [
            "B:Deal.owner_email"
          ]
        },
        {
          "name": "name",
          "type": "text"
        },
        {
          "name": "password",
          "type": "text"
        },
        {
          "name": "role",
          "type": "text"
        },
        {
          "name": "is_active",
          "type": "boolean"
        },
        {
          "name": "created_at",
          "type": "timestamp"
        }
      ]
    },
    {
      "name": "Contact",
      "merged_from": [
        "A:Contact"
      ],
      "primary_key": "uuid",
      "notes": "A's integer id kept in legacy_id.",
      "fields": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "legacy_source",
          "type": "text"
        },
        {
          "name": "legacy_id",
          "type": "text"
        },
        {
          "name": "name",
          "type": "text",
          "from": [
            "A:Contact.name"
          ]
        },
        {
          "name": "email",
          "type": "text unique",
          "from": [
            "A:Contact.email"
          ]
        },
        {
          "name": "company",
          "type": "text",
          "from": [
            "A:Contact.company"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamp"
        },
        {
          "name": "updated_at",
          "type": "timestamp"
        }
      ]
    },
    {
      "name": "Stage",
      "merged_from": [
        "new"
      ],
      "primary_key": "uuid",
      "notes": "New: replaces A's STAGES constant and B's stages parameter. Seeded lead, qualified, proposal, won (outcome won), lost (outcome lost), closed (outcome unspecified, for B's closed deals).",
      "fields": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "name",
          "type": "text"
        },
        {
          "name": "position",
          "type": "integer"
        },
        {
          "name": "outcome",
          "type": "text"
        },
        {
          "name": "is_active",
          "type": "boolean"
        }
      ]
    },
    {
      "name": "Deal",
      "merged_from": [
        "A:Deal",
        "B:Deal"
      ],
      "primary_key": "uuid",
      "notes": "Union of A's and B's fields; stage text becomes a stage_id FK; owner_email becomes owner_id (User.email keeps the value).",
      "fields": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "legacy_source",
          "type": "text"
        },
        {
          "name": "legacy_id",
          "type": "text"
        },
        {
          "name": "contact_id",
          "type": "uuid",
          "from": [
            "A:Deal.contact_id"
          ]
        },
        {
          "name": "title",
          "type": "text",
          "from": [
            "A:Deal.title",
            "B:Deal.title"
          ]
        },
        {
          "name": "value_cents",
          "type": "integer",
          "from": [
            "A:Deal.value_cents"
          ]
        },
        {
          "name": "currency",
          "type": "text"
        },
        {
          "name": "stage_id",
          "type": "uuid",
          "from": [
            "A:Deal.stage",
            "B:Deal.stage"
          ]
        },
        {
          "name": "moved_at",
          "type": "timestamp",
          "from": [
            "B:Deal.moved_at"
          ]
        },
        {
          "name": "owner_id",
          "type": "uuid",
          "from": [
            "B:Deal.owner_email"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamp"
        },
        {
          "name": "updated_at",
          "type": "timestamp"
        }
      ]
    },
    {
      "name": "ContactMerge",
      "merged_from": [
        "new"
      ],
      "primary_key": "uuid",
      "notes": "New audit entry for M02.",
      "fields": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "kept_contact_id",
          "type": "uuid"
        },
        {
          "name": "dropped_contact_legacy",
          "type": "json"
        },
        {
          "name": "deals_moved",
          "type": "integer"
        },
        {
          "name": "merged_by",
          "type": "uuid"
        },
        {
          "name": "merged_at",
          "type": "timestamp"
        }
      ]
    },
    {
      "name": "ReminderLog",
      "merged_from": [
        "new"
      ],
      "primary_key": "uuid",
      "notes": "New: dedupe for M06, unique (deal_id, moved_at).",
      "fields": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "deal_id",
          "type": "uuid"
        },
        {
          "name": "moved_at",
          "type": "timestamp"
        },
        {
          "name": "sent_to",
          "type": "uuid"
        },
        {
          "name": "sent_at",
          "type": "timestamp"
        }
      ]
    }
  ],
  "auth": {
    "method": "email and password (Django auth, PBKDF2/Argon2 password hashing)",
    "session": "server-side session in an http-only, secure, SameSite=Lax cookie; CSRF on every form and unsafe API call",
    "roles": [
      "admin",
      "member"
    ],
    "permissions": {
      "member": [
        "contacts.read",
        "contacts.write",
        "deals.read",
        "deals.write",
        "deals.move",
        "exports.download"
      ],
      "admin": [
        "all member permissions",
        "contacts.merge",
        "stages.configure",
        "users.manage"
      ]
    },
    "role_mapping": {
      "A: no users or roles in the source": "member (A's deals get one default owner chosen by the user)",
      "B: deal owner (owner_email)": "member"
    }
  },
