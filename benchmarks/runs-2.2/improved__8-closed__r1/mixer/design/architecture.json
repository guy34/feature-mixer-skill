  "decisions": [
    {
      "id": "D01",
      "decision": "Backend: Python 3.12 + Django 5",
      "reason": "Spendly is Python; Django provides sessions, password hashing, CSRF, ORM and migrations",
      "approved": true
    },
    {
      "id": "D02",
      "decision": "Database: PostgreSQL; money as bigint minor units + char(3) currency",
      "reason": "constraints for categories and amounts; compatibility decision on expense.amount",
      "approved": true
    },
    {
      "id": "D03",
      "decision": "Frontend: server-rendered, mobile-first web with camera capture",
      "reason": "the user scans on a phone; no app store needed",
      "approved": true
    },
    {
      "id": "D04",
      "decision": "Receipt images in private object storage with retention (default 90 days)",
      "reason": "personal data; keep out of the database",
      "approved": true
    },
    {
      "id": "D05",
      "decision": "Style: modular monolith with adapters for OCR, FX and email",
      "reason": "see style; external calls behind fakes so they can be tested here",
      "approved": true
    },
    {
      "id": "D06",
      "decision": "Authorization: budget membership (owner, member), personal budget per user, one can_access function",
      "reason": "compatibility decisions on authorization and tenancy",
      "approved": true
    },
    {
      "id": "D07",
      "decision": "Conversion to the budget's currency with stored rate and rate date",
      "reason": "compatibility decision conversion-target-currency",
      "approved": true
    },
    {
      "id": "D08",
      "decision": "Scan review shows all fields, flags the date, requires a category; never auto-saves",
      "reason": "user-reported wrong dates; Spendly's category rule",
      "approved": true
    },
    {
