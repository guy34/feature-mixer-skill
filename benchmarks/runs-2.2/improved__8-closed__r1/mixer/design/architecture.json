{
  "style": {
    "selected": "modular-monolith",
    "drivers": [
      "one small team (the user)",
      "strong consistency between budgets, membership and expense totals",
      "modest load: a few people per budget",
      "two slow external calls (OCR, exchange rates) that fit behind adapters with timeouts",
      "no independent scaling or release need"
    ],
    "alternatives": [
      {
        "style": "microservices",
        "fit": "poor",
        "reason": "network calls, distributed data and several deployables with no scaling or team need"
      },
      {
        "style": "event-driven",
        "fit": "partial",
        "reason": "receipt extraction could be asynchronous, but volume is low; a synchronous call with a timeout and manual-entry fallback is simpler"
      },
      {
        "style": "service-oriented",
        "fit": "poor",
        "reason": "no existing system has to stay separate; Spendly is six lines and Tallyho is not integrated"
      },
      {
        "style": "hybrid",
        "fit": "partial",
        "reason": "a queued OCR worker could be added later if scans get slow; not needed for the first version"
      }
    ],
    "reason": "Simplest design that meets every driver; module boundaries keep OCR, FX and email behind adapters"
  },
  "stack": {
    "frontend": "Server-rendered Django templates, mobile-first responsive pages, camera capture through a file input with capture=environment; minimal vanilla JS",
    "backend": "Python 3.12, Django 5.x",
    "database": "PostgreSQL 16",
    "storage": "S3-compatible object storage for receipt images (private bucket, signed URLs)",
    "hosting": "Any container host with managed PostgreSQL, chosen by the user; nothing is deployed automatically",
    "reasons": {
      "frontend": "D03: the user scans on a phone; a responsive web app with camera capture avoids app stores; nothing visual copied from Tallyho",
      "backend": "D01: Spendly is Python (its category rule can be adapted directly); Django brings sessions, password hashing, CSRF, ORM and migrations, so less security code is hand-written",
      "database": "D02: relational data with constraints (category check, positive amounts, membership uniqueness) and money in integer minor units",
      "storage": "D04: receipt photos are personal data; kept private, out of the database, with a retention limit",
      "hosting": "D09: no deployment in this run; boring managed options"
    }
  },
  "modules": [
    {
      "name": "accounts",
      "responsibility": "Sign-up, sign-in, sign-out, sessions, the User record, home currency",
      "features": [],
      "depends_on": [],
      "owns_entities": [
        "User"
      ]
    },
    {
      "name": "categories",
      "responsibility": "The fixed category list from Spendly and its validation",
      "features": [
        "M09"
      ],
      "depends_on": [],
      "owns_entities": []
    },
    {
      "name": "currency",
      "responsibility": "Exchange-rate adapter (provider chosen later; fake in tests) and conversion to minor units",
      "features": [
        "M02"
      ],
      "depends_on": [],
      "owns_entities": [
        "ExchangeRate"
      ]
    },
    {
      "name": "mailer",
      "responsibility": "Email adapter for invitations (SMTP via Django's email backend; console/fake in development and tests)",
      "features": [],
      "depends_on": [],
      "owns_entities": []
    },
    {
      "name": "budgets",
      "responsibility": "Budgets, membership, invitations, member removal, and can_access(user, action, record) used by every route",
      "features": [
        "M03",
        "M04",
        "M07"
      ],
      "depends_on": [
        "accounts",
        "mailer"
      ],
      "owns_entities": [
        "Budget",
        "BudgetMember",
        "Invitation"
      ]
    },
    {
      "name": "expenses",
      "responsibility": "Expense records, listing, editing, deleting, and monthly spent-vs-limit totals",
      "features": [
        "M05",
        "M06",
        "M08"
      ],
      "depends_on": [
        "accounts",
        "budgets",
        "categories",
        "currency"
      ],
      "owns_entities": [
        "Expense"
      ]
    },
    {
      "name": "receipts",
      "responsibility": "Receipt photo upload, extraction adapter (provider chosen later; fake in tests), review and confirm into an expense",
      "features": [
        "M01"
      ],
      "depends_on": [
        "accounts",
        "budgets",
        "expenses",
        "categories",
        "currency"
      ],
      "owns_entities": [
        "ReceiptScan"
      ]
    }
  ],
  "entities": [
    {
      "name": "User",
      "merged_from": [
        "A:User"
      ],
      "primary_key": "id uuid",
      "notes": "A person can belong to many budgets, so User is not owned by one tenant (shared by decision D11). Other members see only display name and email of people in budgets they share; every query of users goes through can_access",
      "fields": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "email",
          "type": "text",
          "from": [
            "A:User.email"
          ]
        },
        {
          "name": "display_name",
          "type": "text"
        },
        {
          "name": "password_hash",
          "type": "text"
        },
        {
          "name": "home_currency",
          "type": "char(3)",
          "from": [
            "A:User.home_currency"
