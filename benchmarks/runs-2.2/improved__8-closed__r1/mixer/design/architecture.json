  "auth": {
    "method": "email and password (Django auth, PBKDF2/Argon2 hashing)",
    "session": "server-side session, http-only Secure SameSite=Lax cookie, CSRF tokens on every form",
    "roles": [
      "owner",
      "member"
    ],
    "permissions": {
      "owner": [
        "view budget",
        "add expense",
        "edit/delete any expense in the budget",
        "edit budget",
        "invite members",
        "remove members"
      ],
      "member": [
        "view budget",
        "add expense",
        "edit/delete own expenses"
      ]
    },
    "role_mapping": {
      "A:owner": "owner",
      "A:member": "member"
    }
  },
