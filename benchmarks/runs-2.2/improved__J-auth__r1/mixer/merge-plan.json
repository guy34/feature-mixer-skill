    {
      "id": "U01",
      "name": "Unified sign-in (password and OAuth) with account linking",
      "menu_ids": [
        "M01",
        "M02",
        "M03"
      ],
      "source_features": [
        "A-F01",
        "A-F02",
        "B-F01"
      ],
      "evidence": [
        "A-E01",
        "A-E02",
        "A-E03",
        "A-E04",
        "B-E01",
        "B-E02"
      ],
      "merge_type": "complementary",
      "rationale": "Password accounts (A) and provider sign-in (B) are two sign-in methods for the same person; one identity store and one session mechanism avoid two account systems, and the user wants one account per person.",
      "behaviour": "register_password creates one user per normalised email (duplicates refused); login_password and login_oauth both return an opaque session token; login_oauth finds the identity by (provider, subject), otherwise joins the existing user with the same email only when email_verified is true, otherwise creates a separate user; whoami resolves a token; logout revokes it.",
      "improvements": "No overwrite on duplicate registration; constant-time hash compare; one AuthError for every sign-in failure; logout and token lookup added; email_verified honoured for linking; email normalised for both methods.",
      "depends_on": [
        "U02"
      ],
      "compatibility": "resolved",
      "validation": "verified",
      "tests": [
