      ],
      "evidence": [
        "C-E03"
      ],
      "merge_type": "unique",
      "rationale": "Roster's role change, tied to the authenticated caller instead of a role string.",
      "behaviour": "set_role(token, user_id, role): the caller is resolved from the session; anyone who is not an admin gets PermissionError; the role must be a known unified role; nobody may raise their own role; the target must exist.",
      "improvements": "Caller from session; role validated; self-raise blocked (user decision).",
