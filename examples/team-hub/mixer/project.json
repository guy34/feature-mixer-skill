{
  "name": "Team Hub",
  "format": 3,
  "mode": "full",
  "audience": "A small team that plans work, gets sign-off and wants one place to see workload",
  "target": {
    "path": "app"
  },
  "sources": [
    {
      "id": "A",
      "name": "TaskBoard",
      "slug": "taskboard",
      "access": "own-code",
      "licence": "own code",
      "code_reuse": "allowed",
      "slice": "tasks, assignment, comments, in-app notifications",
      "local_path": "sources/taskboard",
      "inputs": [
        {
          "kind": "local-directory",
          "location": "sources/taskboard"
        }
      ]
    },
    {
      "id": "B",
      "name": "Approvals",
      "slug": "approvals",
      "access": "open-source",
      "licence": "MIT",
      "code_reuse": "allowed",
      "slice": "approval requests, threaded comments, email notifications, roles",
      "local_path": "sources/approvals",
      "inputs": [
        {
          "kind": "local-directory",
          "location": "sources/approvals"
        }
      ]
    },
    {
      "id": "C",
      "name": "Pulse",
      "slug": "pulse",
      "access": "closed",
      "licence": "proprietary",
      "code_reuse": "not-allowed",
      "slice": "workload dashboard, push notifications",
      "inputs": [
        {
          "kind": "documentation",
          "location": "sources/pulse-docs/docs"
        },
        {
          "kind": "api-spec",
          "location": "sources/pulse-docs/openapi.yaml"
        }
      ]
    }
  ],
