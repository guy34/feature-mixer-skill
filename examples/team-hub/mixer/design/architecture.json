        "M14"
      ],
      "status": "done",
      "checkpoint": "CP6"
    }
  ],
  "decisions": [
    {
      "id": "D01",
      "decision": "Python standard library and SQLite",
      "reason": "The example must run with nothing to install. No source code is reused, so every kept feature is rebuilt or combined.",
      "approved": true
    },
    {
      "id": "D02",
      "decision": "http-only cookie sessions, 30 minutes idle, for every endpoint",
      "reason": "Resolves the session and endpoint-auth conflicts; 30 minutes because approvals are sign-off actions",
      "approved": true
    },
    {
      "id": "D03",
      "decision": "uuid primary keys everywhere; B's ids kept in legacy_id on import",
      "reason": "Resolves the critical primary key conflict",
      "approved": true
    },
    {
      "id": "D04",
      "decision": "Roles owner, admin, member plus an approve permission",
      "reason": "Resolves the role conflict without multiplying roles",
      "approved": true
    },
    {
      "id": "D05",
      "decision": "One unversioned /api with one user shape and one error format",
      "reason": "No outside clients yet; resolves contract and version conflicts",
      "approved": true
    },
    {
      "id": "D06",
      "decision": "Timestamps stored in UTC; overdue means due before today's UTC date",
      "reason": "Pulse does not document its rule (an unknown in C's report)",
      "approved": true
    },
    {
      "id": "D07",
      "decision": "All settings from environment variables in one config module",
      "reason": "One configuration strategy",
      "approved": true
    },
    {
      "id": "D08",
      "decision": "Modular monolith",
      "reason": "See style: one team, strong consistency, low load",
      "approved": true
    }
  ],
  "style": {
    "selected": "modular-monolith",
    "drivers": [
      "one small team and one release cadence",
      "tasks, approvals and notifications must stay consistent in one transaction",
      "low load, no part needs to scale on its own",
      "the example must run with nothing to install (D01)"
    ],
    "alternatives": [
      {
        "style": "microservices",
        "fit": "poor",
        "reason": "Seven small modules with shared data would become seven deployables and distributed transactions for no scaling or team benefit"
      },
      {
        "style": "event-driven",
        "fit": "partial",
        "reason": "Notifications are naturally asynchronous, but at this volume a queued deliveries table does the job without a message broker"
      },
      {
        "style": "hybrid",
        "fit": "partial",
        "reason": "Worth revisiting if notification volume grows: move delivery to an event-driven worker and keep the core as is"
      },
      {
        "style": "service-oriented",
        "fit": "poor",
        "reason": "There is no existing system that must stay a separate service"
      }
    ],
    "reason": "The simplest design that meets every driver; module boundaries (and the status-guard callback) keep a later split possible."
  }
}
