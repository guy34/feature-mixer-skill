  "design_system": {
    "note": "The example ships the API only. A UI would use one token set and one component library (one Button with primary, secondary, ghost and danger)."
  },
  "configuration": {
    "TEAMHUB_DB": "database file",
    "TEAMHUB_SESSION_IDLE_MINUTES": "idle timeout, default 30",
    "TEAMHUB_PASSWORD_ITERATIONS": "PBKDF2 iterations, default 200000",
    "TEAMHUB_HOST": "bind address",
    "TEAMHUB_PORT": "port",
    "TEAMHUB_SECURE_COOKIE": "1 behind HTTPS"
  },
  "slices": [
    {
