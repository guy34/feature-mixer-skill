{
  "stack": {
    "language": "Python 3.8+ (standard library only)",
    "web": "http.server JSON API",
    "database": "SQLite",
    "auth": "Own accounts, PBKDF2 password hashes, http-only cookie sessions",
    "reasons": {
      "language": "D01: the example must run anywhere with nothing to install; a production build would weigh Node and React, which A and B already use",
      "database": "D01: SQLite ships with Python; the schema is plain SQL that moves to PostgreSQL unchanged apart from types",
      "auth": "D02: cookie sessions from A, chosen in the compatibility phase"
    }
  },
  "modules": [
    {
      "name": "accounts",
      "responsibility": "Users, sign-in, sessions, roles and the permission check",
      "features": [
        "M01",
        "M08",
        "M09"
      ],
      "depends_on": [],
      "owns_entities": [
        "User",
        "Session"
      ]
    },
    {
      "name": "notifications",
      "responsibility": "One engine: every event creates one notification, delivered in-app, by email and by push according to preferences",
      "features": [
        "M10",
        "M11",
        "M12"
      ],
      "depends_on": [
        "accounts"
      ],
      "owns_entities": [
        "Notification",
        "Delivery",
        "PushSubscription"
      ]
    },
    {
      "name": "tasks",
      "responsibility": "Task board, status changes and assignment; lets other modules veto status changes",
      "features": [
        "M04",
        "M05"
      ],
      "depends_on": [
        "accounts",
        "notifications"
      ],
      "owns_entities": [
        "Task"
      ]
    },
    {
      "name": "approvals",
      "responsibility": "Approval requests on tasks and decisions; blocks closing a task with a pending approval",
      "features": [
        "M13"
      ],
      "depends_on": [
        "accounts",
        "tasks",
        "notifications"
      ],
      "owns_entities": [
        "Approval"
      ]
    },
    {
      "name": "comments",
      "responsibility": "Threaded comments on tasks and approvals",
      "features": [
        "M07"
      ],
      "depends_on": [
        "accounts",
        "notifications"
      ],
      "owns_entities": [
        "Comment"
      ]
    },
    {
      "name": "dashboard",
      "responsibility": "Workload: open tasks per person, overdue tasks, pending approvals",
      "features": [
        "M14"
      ],
      "depends_on": [
        "accounts",
        "tasks",
        "approvals"
      ],
      "owns_entities": []
    },
    {
      "name": "api",
      "responsibility": "HTTP routes, JSON in and out, one error format",
      "features": [],
      "depends_on": [
        "accounts",
        "notifications",
        "tasks",
        "approvals",
        "comments",
        "dashboard"
      ],
      "owns_entities": []
    }
  ],
  "entities": [
    {
      "name": "User",
      "merged_from": [
        "A:User",
        "B:User"
      ],
      "primary_key": "uuid",
      "notes": "B's full_name becomes name; B's integer ids go to legacy_id on import (D03)",
      "fields": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "email",
          "type": "text"
        },
        {
          "name": "name",
          "type": "text",
          "from": [
            "A:User.name",
            "B:User.full_name"
          ]
        },
        {
          "name": "password_hash",
          "type": "text"
        },
        {
          "name": "role",
          "type": "text"
        },
        {
          "name": "can_approve",
          "type": "boolean"
        },
        {
          "name": "notify_email",
          "type": "boolean"
        },
        {
          "name": "notify_push",
          "type": "boolean"
        },
        {
          "name": "legacy_id",
          "type": "text"
        },
        {
          "name": "created_at",
          "type": "timestamp"
        }
      ]
    },
    {
      "name": "Session",
      "merged_from": [
        "new"
      ],
      "primary_key": "token"
    },
    {
      "name": "Task",
      "merged_from": [
        "A:Task"
      ],
      "primary_key": "uuid"
    },
    {
      "name": "Approval",
      "merged_from": [
        "B:ApprovalRequest"
      ],
      "primary_key": "uuid",
      "notes": "Now attached to a task. B's request title is not kept here: on import it becomes the linked task's title (approved as A03).",
      "fields": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "task_id",
          "type": "uuid"
        },
        {
          "name": "requester_id",
          "type": "uuid"
        },
        {
          "name": "approver_id",
          "type": "uuid"
        },
        {
          "name": "status",
          "type": "text"
        },
        {
          "name": "note",
          "type": "text"
        },
        {
          "name": "created_at",
          "type": "timestamp"
        },
        {
          "name": "decided_at",
          "type": "timestamp"
        }
      ]
    },
    {
      "name": "Comment",
      "merged_from": [
        "B:Comment"
      ],
      "primary_key": "uuid",
      "notes": "subject_type task or approval; parent_id for replies"
    },
    {
      "name": "Notification",
      "merged_from": [
        "A:Notification"
      ],
      "primary_key": "uuid",
      "notes": "Adds event and a unique dedupe_key"
    },
    {
      "name": "Delivery",
      "merged_from": [
        "B:EmailOutbox"
      ],
      "primary_key": "uuid",
      "notes": "One row per email or push delivery"
    },
    {
      "name": "PushSubscription",
      "merged_from": [
        "C:PushSubscription"
      ],
      "primary_key": "uuid",
      "notes": "Rebuilt from Pulse's published API schema"
    }
  ],
  "auth": {
    "method": "email and password",
    "session": "http-only cookie, 30 minutes idle",
    "roles": [
      "owner",
      "admin",
      "member"
    ],
    "permissions": {
      "approve": "can_approve flag",
      "manage users": "owner, admin",
      "manage any task": "owner, admin"
    },
    "role_mapping": {
      "A:owner": "owner",
      "A:member": "member",
      "B:admin": "admin",
      "B:requester": "member",
      "B:approver": "member + approve",
      "C:admin": "admin",
      "C:member": "member"
    }
  },
  "navigation": [],
  "api": [
