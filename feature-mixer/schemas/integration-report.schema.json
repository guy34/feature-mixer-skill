{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guy34/feature-mixer-skill/blob/main/feature-mixer/schemas/integration-report.schema.json",
  "title": "Feature Mixer integration test report",
  "description": "mixer/integration-report.json: results of the test runs that prove each kept feature works.",
  "type": "object",
  "required": [
    "app",
    "command",
    "summary",
    "tests"
  ],
  "properties": {
    "app": {
      "type": "string"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "not_executed": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "verdict": {
          "enum": [
            "passed",
            "failed",
            "no-tests",
            "incomplete",
            "inconsistent",
            "invalid-results",
            "timed-out",
            "interrupted"
          ]
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "name",
          "features",
          "expected",
          "actual",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "unit",
              "feature",
              "interaction",
              "api",
              "database",
              "auth",
              "authorization",
              "navigation",
              "form",
              "error",
              "dependency",
              "journey",
              "regression"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^M\\d{2,}$"
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-executed",
              "skipped",
              "unverified",
              "pass",
              "fail",
              "skip"
            ],
            "description": "pass/fail/skip are the v2.0 names, read as passed/failed/skipped."
          },
          "error": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC\\d{2,}$"
            }
          }
        }
      },
      "description": "Every test of the run. An empty list is valid JSON but verify_tests.py treats it as proving nothing."
    },
    "framework": {
      "type": "string"
    },
    "execution": {
      "type": "object",
      "required": [
        "run_id",
        "runner",
        "started_at",
        "finished_at",
        "exit_code",
        "log",
        "log_sha256",
        "results",
        "results_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "log": {
          "type": "string"
        },
        "log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "results": {
          "type": "string"
        },
        "results_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approval": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "enum": [
            "exited",
            "timed_out",
            "interrupted"
          ]
        },
        "verdict": {
          "enum": [
            "passed",
            "failed",
            "no-tests",
            "incomplete",
            "inconsistent",
            "invalid-results",
            "timed-out",
            "interrupted"
          ]
        },
        "results_status": {
          "enum": [
            "ok",
            "missing",
            "malformed",
            "too-large",
            "inconsistent",
            "stale"
          ]
        },
        "run_record_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "code_sha256_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "description": "Written by run_tests.py from an actual run. Without it every result is reported but unverified."
    }
  }
}
