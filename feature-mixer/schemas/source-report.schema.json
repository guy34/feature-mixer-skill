{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guy34/feature-mixer-skill/blob/main/feature-mixer/schemas/source-report.schema.json",
  "title": "Feature Mixer source report",
  "description": "mixer/sources/<id>-<slug>/source.json: everything extracted from one source app, with evidence.",
  "type": "object",
  "required": [
    "app",
    "coverage",
    "sources_used",
    "evidence",
    "features",
    "unknowns"
  ],
  "properties": {
    "app": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "sources_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "kind",
          "location"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}-R\\d{2,}$"
          },
          "kind": {
            "enum": [
              "website",
              "local-directory",
              "github",
              "screenshots",
              "documentation",
              "api-spec",
              "source-code",
              "own-account"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "accessed": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "basis",
          "locator",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}-E\\d{2,}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}-R\\d{2,}$"
          },
          "basis": {
            "enum": [
              "observed",
              "documented",
              "inferred",
              "unknown"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "description": "file:line, URL#section, screenshot name, or spec path"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "properties": {
        "frontend": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backend": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "database": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "infrastructure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "basis": {
          "enum": [
            "observed",
            "documented",
            "inferred",
            "unknown"
          ]
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "architecture": {
      "type": "object",
      "properties": {
        "frontend": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}-E\\d{2,}$"
          }
        },
        "basis": {
          "enum": [
            "observed",
            "documented",
            "inferred",
            "unknown"
          ]
        }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}-S\\d{2,}$"
          },
          "name": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-E\\d{2,}$"
            }
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "steps",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}-W\\d{2,}$"
          },
          "name": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-S\\d{2,}$"
            }
          },
          "edge_cases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-E\\d{2,}$"
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "evidence",
          "basis",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}-F\\d{2,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "observed_behaviour": {
            "type": "string"
          },
          "business_logic": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-F\\d{2,}$"
            }
          },
          "integration": {
            "type": "string"
          },
          "subfeatures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-E\\d{2,}$"
            }
          },
          "basis": {
            "enum": [
              "observed",
              "documented",
              "inferred",
              "unknown"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "fields",
          "evidence",
          "basis"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "primary_key": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "foreign_keys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "references"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "references": {
                  "type": "string"
                },
                "on_delete": {
                  "type": "string"
                }
              }
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-F\\d{2,}$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-E\\d{2,}$"
            }
          },
          "basis": {
            "enum": [
              "observed",
              "documented",
              "inferred",
              "unknown"
            ]
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "path",
          "evidence",
          "basis"
        ],
        "properties": {
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "auth": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "request": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "response": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-F\\d{2,}$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-E\\d{2,}$"
            }
          },
          "basis": {
            "enum": [
              "observed",
              "documented",
              "inferred",
              "unknown"
            ]
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}-E\\d{2,}$"
          }
        },
        "basis": {
          "enum": [
            "observed",
            "documented",
            "inferred",
            "unknown"
          ]
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "screen": {
            "type": "string"
          }
        }
      }
    },
    "state": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-F\\d{2,}$"
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "used_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-S\\d{2,}$"
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "value",
          "evidence"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {},
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-F\\d{2,}$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-E\\d{2,}$"
            }
          }
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-F\\d{2,}$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}-E\\d{2,}$"
            }
          }
        }
      }
    },
    "configuration": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "error_handling": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case",
          "behaviour"
        ],
        "properties": {
          "case": {
            "type": "string"
          },
          "behaviour": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "size": {
      "enum": [
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "coverage_detail": {
      "type": "object",
      "required": [
        "modules_analysed"
      ],
      "properties": {
        "index": {
          "type": "string",
          "description": "index.json written by index_repo.py, relative to this folder"
        },
        "modules_analysed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules_skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "module",
              "reason"
            ],
            "properties": {
              "module": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "files_read": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
