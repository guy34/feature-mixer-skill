{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guy34/feature-mixer-skill/blob/main/feature-mixer/schemas/project.schema.json",
  "title": "Feature Mixer project",
  "description": "mixer/project.json: the source apps, the mode, phase status, approvals and checkpoints.",
  "type": "object",
  "required": [
    "name",
    "format",
    "mode",
    "sources",
    "phases"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "integer",
      "enum": [
        2,
        3
      ],
      "description": "2: a v2.0 workspace (v2.1 checks are warnings). 3: a v2.1 workspace (v2.1 checks are errors)."
    },
    "mode": {
      "enum": [
        "full",
        "plan",
        "auto-pick"
      ],
      "description": "How far the run goes: full or plan. 'auto-pick' (v2.0) means full with automatic selection."
    },
    "audience": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Where the unified app is built, relative to the folder holding mixer/."
        },
        "branch": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "phases": {
      "type": "object",
      "properties": {
        "recon": {
          "$ref": "#/$defs/phase"
        },
        "extraction": {
          "$ref": "#/$defs/phase"
        },
        "selection": {
          "$ref": "#/$defs/phase"
        },
        "compatibility": {
          "$ref": "#/$defs/phase"
        },
        "architecture": {
          "$ref": "#/$defs/phase"
        },
        "implementation": {
          "$ref": "#/$defs/phase"
        },
        "integration": {
          "$ref": "#/$defs/phase"
        },
        "deployment": {
          "$ref": "#/$defs/phase"
        }
      },
      "additionalProperties": false
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkpoint"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      },
      "description": "Every approval the user gave for a risky action."
    },
    "selection": {
      "enum": [
        "manual",
        "auto-pick"
      ],
      "description": "Who picks the features: the user (manual, default) or Claude (auto-pick). Combines with either mode."
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "slug",
        "access",
        "code_reuse",
        "inputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "access": {
          "enum": [
            "own-code",
            "open-source",
            "closed"
          ],
          "description": "own-code: the user's own project. open-source: public code under a licence. closed: behaviour only."
        },
        "licence": {
          "type": "string"
        },
        "code_reuse": {
          "enum": [
            "allowed",
            "not-allowed",
            "unknown"
          ],
          "description": "Whether reuse or adapt strategies may copy this source's code."
        },
        "slice": {
          "type": "string"
        },
        "local_path": {
          "type": "string",
          "description": "A read-only local copy of the code, if any."
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "location"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "website",
                  "local-directory",
                  "github",
                  "screenshots",
                  "documentation",
                  "api-spec",
                  "source-code",
                  "own-account"
                ]
              },
              "location": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "phase": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "in-progress",
            "done",
            "failed",
            "rolled-back"
          ]
        },
        "approved": {
          "type": "boolean"
        },
        "date": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "id",
        "phase",
        "ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CP\\d+$"
        },
        "phase": {
          "enum": [
            "recon",
            "extraction",
            "selection",
            "compatibility",
            "architecture",
            "implementation",
            "integration"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "git tag or commit, or a snapshot folder."
        },
        "date": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "id",
        "action",
        "target",
        "approved",
        "by",
        "date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A\\d{2,}$"
        },
        "action": {
          "enum": [
            "run-source-code",
            "install-dependencies",
            "run-tests",
            "network",
            "destructive",
            "migration",
            "deployment",
            "other"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "approved": {
          "type": "boolean"
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
