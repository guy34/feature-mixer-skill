{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guy34/feature-mixer-skill/blob/main/feature-mixer/schemas/feature.schema.json",
  "title": "Feature Mixer feature menu row",
  "description": "One row of mixer/feature-menu.csv. Empty strings mean not set yet.",
  "type": "object",
  "required": [
    "id",
    "feature",
    "depends_on",
    "conflicts_with",
    "pick"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^M\\d{2,}$"
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "area": {
      "type": "string"
    },
    "source_app": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "",
        "must",
        "should",
        "could"
      ]
    },
    "complexity": {
      "type": "string",
      "enum": [
        "",
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "depends_on": {
      "type": "string",
      "pattern": "^(M\\d{2,}(\\s*[;,]\\s*M\\d{2,})*)?$"
    },
    "conflicts_with": {
      "type": "string",
      "pattern": "^(M\\d{2,}(\\s*[;,]\\s*M\\d{2,})*)?$"
    },
    "pick": {
      "type": "string",
      "enum": [
        "",
        "keep",
        "drop",
        "later",
        "skip"
      ]
    },
    "notes": {
      "type": "string"
    },
    "merge_group": {
      "type": "string",
      "pattern": "^([a-z0-9][a-z0-9-]*)?$"
    },
    "merge_type": {
      "type": "string",
      "enum": [
        "",
        "identical",
        "similar",
        "complementary",
        "unique",
        "incompatible",
        "separate",
        "conflicting",
        "independent"
      ],
      "description": "conflicting and independent are other names for incompatible and unique."
    },
    "evidence_refs": {
      "type": "string",
      "pattern": "^([A-Z]{1,3}-E\\d{2,}(\\s*[;,]\\s*[A-Z]{1,3}-E\\d{2,})*)?$"
    },
    "compatibility": {
      "type": "string",
      "enum": [
        "",
        "compatible",
        "adaptable",
        "conflict",
        "incompatible",
        "unknown"
      ]
    },
    "implementation_strategy": {
      "type": "string",
      "enum": [
        "",
        "reuse",
        "rebuild",
        "adapt",
        "combine",
        "improve",
        "reject"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "",
        "high",
        "medium",
        "low"
      ]
    },
    "integration_notes": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source_features": {
      "type": "string",
      "pattern": "^([A-Z]{1,3}-F\\d{2,}(\\s*[;,]\\s*[A-Z]{1,3}-F\\d{2,})*)?$"
    }
  }
}
